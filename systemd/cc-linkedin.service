[Unit]
Description=LinkedIn Post Generator (cmdr pipeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/linkedin-post-gen
WorkingDirectory=%h/Programs/ai/computeCommander
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cc-linkedin

# Give claude -p enough time to generate content + create Gmail draft
TimeoutStartSec=600

# Environment for dunst notifications and headless claude
Environment=HOME=%h
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=CLAUDECODE=
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/go/bin:%h/.cargo/bin

[Install]
WantedBy=default.target
